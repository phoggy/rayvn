#!/usr/bin/env bash

projectName='rayvn'
projectDescription='A shared library ecosystem for bash 5.3+.'
projectVersion='0.5.0'
projectReleaseDate='2026-11-08 13:19:34 PST'
docsWorktree='../rayvn-pages'

# Brew formula metadata (used by rayvn/dependencies for formula generation and runtime dep checks)
declare -A nixBrewMap=([gnused]='gnu-sed' [bash-completion]='bash-completion@2')  # nix pkg name → homebrew formula name when they differ
declare -A nixBinaryMap=([gnused]='gsed' [bundler]='bundle')    # nix pkg name → binary name when they differ
declare -a nixBrewExclude=('bundler' 'jekyll' 'gnugrep')       # excluded from brew formula (bundler, jekyll: managed via gemDeps;
                                                                # gnugrep: for Nix's minimal PATH, the system grep is used otherwise)
declare -a nixSkipBinaryCheck=('bash-completion')                # no on-PATH binary to check; it's a sourced shell library
declare -A gemDeps=([bundler]='bundle')                         # gem name → binary name; jekyll is managed by bundler via Gemfile
